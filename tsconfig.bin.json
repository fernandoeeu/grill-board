{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/bin/**/*.ts", "src/server/db/**/*.ts", "src/core/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
